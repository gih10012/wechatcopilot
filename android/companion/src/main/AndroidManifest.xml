<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.tencent.wework" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="wechatcopilot companion"
        android:usesCleartextTraffic="false">
        <service
            android:name=".WeComAccessibilityService"
            android:exported="true"
            android:label="wechatcopilot WeCom accessibility"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".WeComNotificationListenerService"
            android:exported="true"
            android:label="wechatcopilot WeCom notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootstrapReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.wechatcopilot.companion.BOOTSTRAP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
